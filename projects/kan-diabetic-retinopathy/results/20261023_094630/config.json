{
  "data": {
    "dataset": "synthetic",
    "data_dir": "./data",
    "image_size": 224,
    "num_classes": 5,
    "batch_size": 16,
    "num_workers": 4,
    "train_split": 0.8,
    "val_split": 0.1,
    "test_split": 0.1,
    "augmentation": true,
    "class_weights": true
  },
  "kan": {
    "hidden_dims": [
      64,
      32
    ],
    "grid_size": 5,
    "spline_order": 3,
    "scale_noise": 0.1,
    "scale_base": 1.0,
    "scale_spline": 1.0,
    "base_activation": "silu",
    "grid_eps": 0.02,
    "grid_range": [
      -1.0,
      1.0
    ]
  },
  "mlp": {
    "hidden_dims": [
      512,
      256,
      128
    ],
    "dropout": 0.3,
    "activation": "relu",
    "batch_norm": true
  },
  "cnn": {
    "backbone": "resnet18",
    "pretrained": false,
    "feature_dim": 512,
    "freeze_backbone": false
  },
  "hybrid": {
    "cnn_backbone": "resnet18",
    "kan_hidden_dims": [
      128,
      64
    ],
    "freeze_cnn": false,
    "feature_dim": 512
  },
  "training": {
    "epochs": 3,
    "learning_rate": 0.0001,
    "weight_decay": 1e-05,
    "optimizer": "adamw",
    "scheduler": "cosine",
    "warmup_epochs": 5,
    "label_smoothing": 0.1,
    "mixup_alpha": 0.2,
    "early_stopping_patience": 15,
    "gradient_clip": 1.0,
    "seed": 42
  },
  "quantization": {
    "enabled": true,
    "method": "dynamic",
    "backend": "fbgemm",
    "calibration_batches": 100
  },
  "experiment": {
    "name": "kan_diabetic_retinopathy",
    "results_dir": "./results",
    "checkpoint_dir": "./checkpoints",
    "log_dir": "./logs",
    "device": "cpu",
    "debug_mode": true,
    "debug_epochs": 3,
    "debug_batches": 5,
    "debug_samples": 200,
    "log_interval": 10,
    "save_checkpoints": true,
    "checkpoint_interval": 10,
    "monitor_resources": true
  }
}