{
  "model": {
    "model_name": "distilgpt2",
    "max_length": 64,
    "pad_token": "<|pad|>"
  },
  "lora": {
    "r": 8,
    "lora_alpha": 16,
    "lora_dropout": 0.1,
    "target_modules": [
      "c_attn",
      "c_proj"
    ],
    "bias": "none",
    "task_type": "CAUSAL_LM"
  },
  "training": {
    "output_dir": "./checkpoints",
    "num_epochs": 1,
    "batch_size": 4,
    "gradient_accumulation_steps": 4,
    "effective_batch_size": 32,
    "max_grad_norm": 1.0,
    "logging_steps": 10,
    "eval_steps": 50,
    "save_steps": 100,
    "seed": 42,
    "fp16": false,
    "optimizer": {
      "name": "AdamW",
      "learning_rate": 0.0002,
      "weight_decay": 0.01,
      "beta1": 0.9,
      "beta2": 0.999,
      "eps": 1e-08
    },
    "scheduler": {
      "name": "cosine_with_warmup",
      "warmup_steps": 100,
      "warmup_ratio": 0.1,
      "min_lr_ratio": 0.1
    }
  },
  "data": {
    "dataset_name": "wikitext",
    "dataset_config": "wikitext-2-raw-v1",
    "train_split": "train",
    "val_split": "validation",
    "test_split": "test",
    "max_train_samples": 100,
    "max_val_samples": 50,
    "max_test_samples": 50
  }
}