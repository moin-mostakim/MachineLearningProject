{
  "model": {
    "hidden_dims": [
      128,
      64
    ],
    "num_classes": 10,
    "dropout": 0.2
  },
  "federated": {
    "num_clients": 10,
    "clients_per_round": 5,
    "num_rounds": 20,
    "local_epochs": 2
  },
  "dp": {
    "epsilon": 8.0,
    "delta": 1e-05,
    "max_grad_norm": 1.0,
    "noise_multiplier": 1.1
  },
  "training": {
    "batch_size": 32,
    "learning_rate": 0.01,
    "weight_decay": 0.0001
  },
  "data": {
    "dataset": "cifar10",
    "iid": false,
    "alpha": 0.5,
    "samples_per_client": 500
  },
  "seed": 42
}