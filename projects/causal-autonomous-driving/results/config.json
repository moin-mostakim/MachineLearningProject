{
  "model": {
    "backbone": "resnet18",
    "feature_dim": 512,
    "num_classes": 5,
    "dropout": 0.3
  },
  "irm": {
    "penalty_weight": 10000.0,
    "penalty_anneal_iters": 100
  },
  "training": {
    "num_epochs": 2,
    "batch_size": 8,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "num_environments": 3
  },
  "data": {
    "image_size": 16,
    "num_samples_per_env": 50,
    "train_split": 0.7,
    "val_split": 0.15
  },
  "seed": 42
}